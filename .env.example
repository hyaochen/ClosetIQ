# Database
DB_PASSWORD=changeme_use_strong_password

# PostgreSQL connection (used by Prisma)
DATABASE_URL=postgresql://closet:changeme_use_strong_password@localhost:5432/closet

# JWT
JWT_SECRET=changeme_use_random_string_at_least_32_chars
JWT_REFRESH_SECRET=changeme_use_different_random_string

# API
API_PORT=3001
API_HOST=0.0.0.0

# Image storage
IMAGE_STORAGE_PATH=./data/images

# CORS (comma-separated origins, optional)
# CORS_ORIGIN=http://localhost:8083,https://your-domain.com

# OpenWeatherMap (free tier)
OPENWEATHER_API_KEY=your_api_key_here
