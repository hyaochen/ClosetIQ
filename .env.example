# Database
DB_PASSWORD=changeme_use_strong_password

# PostgreSQL connection (used by Prisma)
DATABASE_URL=postgresql://closet:changeme_use_strong_password@localhost:5432/closet

# JWT
JWT_SECRET=changeme_use_random_string_at_least_32_chars
JWT_REFRESH_SECRET=changeme_use_different_random_string

# API
API_PORT=3001
API_HOST=0.0.0.0

# Image storage
IMAGE_STORAGE_PATH=./data/images

# CORS (comma-separated origins, optional)
# CORS_ORIGIN=http://localhost:8083,https://your-domain.com

# Weather: Open-Meteo (no API key needed). OPENWEATHER_API_KEY is no longer used.

# ---- P2 ---- Background removal (rembg sidecar, compose-internal)
# Leave REMBG_URL empty to disable cutouts entirely (uploads then behave as before).
# REMBG_URL=http://rembg:7000
# REMBG_MODEL=isnet-general-use
# CUTOUT_TIMEOUT_MS=60000

# ---- P2 ---- AI item recognition (POST /api/items/analyze)
# With docker compose the key is read from a separate gitignored file ".env.ai" (env_file),
# NOT through shell interpolation, so a key exported in your shell can never leak in by accident.
# AI_PROVIDER=auto            # auto (claude if key set, else bridge if token set, else off) | bridge | claude | mock
# CLAUDE_BRIDGE_TOKEN=<generated by tools/claude-bridge/setup-token.mjs, do not hand-write>
# AI_ALLOWED_USER_IDS=<your ClosetIQ user id; comma separated; empty = nobody may use the subscription bridge>
ANTHROPIC_API_KEY=<your-key-here>
# CLAUDE_MODEL=claude-sonnet-5-5
# AI_DAILY_LIMIT=30           # analyses per user per day (Asia/Taipei calendar day)
