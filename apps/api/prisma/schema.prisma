generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  displayName  String
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        ClothingItem[]
  outfits      Outfit[]
  wearLogs     WearLog[]
  plannedOutfits PlannedOutfit[] // P5
  trips          Trip[]          // P5
}

model ClothingItem {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  category         String          // TOP, BOTTOM, OUTERWEAR, DRESS, SHOES, ACCESSORY, UNDERWEAR, BAG
  subcategory      String?
  colors           String[]        // hex color codes
  colorFamily      String          // RED, BLUE, GREEN, etc.
  pattern          String          @default("SOLID")
  material         String?
  brand            String?
  size             String?
  seasons          String[]        // SPRING, SUMMER, AUTUMN, WINTER
  occasions        String[]        // CASUAL, WORK, FORMAL, SPORT, LOUNGE
  purchaseDate     DateTime?
  purchasePrice    Decimal?        @db.Decimal(10, 2)
  purchaseLocation String?
  condition        String          @default("GOOD") // NEW, GOOD, FAIR, WORN
  notes            String?
  tags             String[]
  isActive         Boolean         @default(true)
  declutterReason  String?         // DONATED, SOLD, DISCARDED, GIFTED
  declutteredAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  images       ClothingImage[]
  outfitItems  OutfitItem[]
  wearLogItems WearLogItem[]
  plannedOutfitItems PlannedOutfitItem[] // P5
  tripItems          TripItem[]          // P5

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isActive])
}

model ClothingImage {
  id             String       @id @default(uuid())
  clothingItemId String
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)
  originalPath   String
  displayPath    String
  thumbnailPath  String
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([clothingItemId])
}

model Outfit {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  occasions String[]
  seasons   String[]
  rating    Int?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  items    OutfitItem[]
  wearLogs WearLog[]
  plannedOutfits PlannedOutfit[] // P5

  @@index([userId])
}

model OutfitItem {
  id             String       @id @default(uuid())
  outfitId       String
  outfit         Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  clothingItemId String
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)
  layerOrder     Int          @default(0)

  @@unique([outfitId, clothingItemId])
  @@index([outfitId])
}

model WearLog {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitId         String?
  outfit           Outfit?       @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  date             DateTime      @db.Date
  occasion         String?
  weatherTemp      Int?
  weatherCondition String?
  notes            String?
  createdAt        DateTime      @default(now())

  items WearLogItem[]

  @@index([userId])
  @@index([userId, date])
}

model WearLogItem {
  id             String       @id @default(uuid())
  wearLogId      String
  wearLog        WearLog      @relation(fields: [wearLogId], references: [id], onDelete: Cascade)
  clothingItemId String
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@unique([wearLogId, clothingItemId])
  @@index([wearLogId])
  @@index([clothingItemId])
}

// ---- P5 ----
// 規則：同一使用者同一天只有一筆計畫（PUT 為整筆取代）

model PlannedOutfit {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  outfitId  String?
  outfit    Outfit?  @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime @default(now())

  items PlannedOutfitItem[]

  @@unique([userId, date])
  @@index([userId, date])
}

model PlannedOutfitItem {
  id              String        @id @default(uuid())
  plannedOutfitId String
  plannedOutfit   PlannedOutfit @relation(fields: [plannedOutfitId], references: [id], onDelete: Cascade)
  clothingItemId  String
  clothingItem    ClothingItem  @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@unique([plannedOutfitId, clothingItemId])
  @@index([plannedOutfitId])
  @@index([clothingItemId])
}

model Trip {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  destination String
  lat         Float?
  lon         Float?
  startDate   DateTime   @db.Date
  endDate     DateTime   @db.Date
  createdAt   DateTime   @default(now())

  items TripItem[]

  @@index([userId])
  @@index([userId, startDate])
}

model TripItem {
  id             String        @id @default(uuid())
  tripId         String
  trip           Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  clothingItemId String?
  clothingItem   ClothingItem? @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)
  customName     String?       // 非衣物項目，例如雨傘
  category       String?
  quantity       Int           @default(1)
  packed         Boolean       @default(false)
  reason         String?
  isAuto         Boolean       @default(false) // true = generate 產生；重新產生時未勾選的 isAuto 項目會被取代
  sortOrder      Int           @default(0)

  @@index([tripId])
  @@index([clothingItemId])
}
